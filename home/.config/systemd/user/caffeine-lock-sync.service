[Unit]
Description=GNOME lock policy and shared Caffeine sleep inhibition
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/ACodeSpace/push/DeviceManagement/MyUbuntu/bin/caffeine-lock-sync
Restart=on-failure
RestartSec=3s
TimeoutStopSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
