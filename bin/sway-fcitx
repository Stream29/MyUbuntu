#!/usr/bin/env bash

set -u

readonly RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
readonly STATE_DIR="${RUNTIME_DIR}/sway-fcitx"
readonly STATE_FILE="${STATE_DIR}/$$"
readonly ACTIVE_DISPLAY_ENV_FILE="${SWAY_FCITX_ACTIVE_DISPLAY_ENV_FILE:-${RUNTIME_DIR}/active-display.env}"
readonly ACTIVE_TTY_PATH="${SWAY_FCITX_ACTIVE_TTY_PATH:-/sys/class/tty/tty0/active}"
readonly SESSIONS_DIR="${SWAY_FCITX_SESSIONS_DIR:-/run/systemd/sessions}"
readonly FCITX_LAUNCHER_BIN="${SWAY_FCITX_LAUNCHER_BIN:-/usr/libexec/fcitx5-wayland-launcher}"
readonly FCITX_LAUNCHER_RETRY_SECONDS="${SWAY_FCITX_LAUNCHER_RETRY_SECONDS:-1}"
readonly SWAYMSG_BIN="${SWAY_FCITX_SWAYMSG_BIN:-/usr/bin/swaymsg}"

FCITX_LAUNCHER_PID=''
KIMPANEL_MONITOR_PID=''
SWAYMSG_PID=''
KIMPANEL_CONTROL_MODE=''
GNOME_TTY=''
GNOME_WAYLAND_DISPLAY='wayland-0'
GNOME_DISPLAY=':0'
SWAY_TTY=''
SWAY_WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}"
SWAY_DISPLAY="${DISPLAY:-}"
SWAY_SOCK="${SWAYSOCK:-}"

set_kimpanel_suspended() {
    local suspended="$1"

    case "${KIMPANEL_CONTROL_MODE}" in
        helper)
            /usr/bin/gdbus call \
                --session \
                --dest org.fcitx.GnomeHelper \
                --object-path /org/fcitx/GnomeHelper \
                --method org.fcitx.GnomeHelper.SetPanelSuspended \
                "${suspended}" \
                >/dev/null 2>&1
            ;;
        extension)
            if [ "${suspended}" = 'true' ]; then
                /usr/bin/gnome-extensions disable kimpanel@kde.org \
                    >/dev/null 2>&1
            else
                /usr/bin/gnome-extensions enable kimpanel@kde.org \
                    >/dev/null 2>&1
            fi
            ;;
        *)
            return 1
            ;;
    esac
}

find_gnome_tty() {
    local session_file=''
    local session_uid=''
    local session_type=''
    local session_service=''
    local session_tty=''
    local key=''
    local value=''

    for session_file in "${SESSIONS_DIR}"/*; do
        [ -r "${session_file}" ] || continue

        session_uid=''
        session_type=''
        session_service=''
        session_tty=''

        while IFS='=' read -r key value; do
            case "${key}" in
                UID)
                    session_uid="${value}"
                    ;;
                TYPE)
                    session_type="${value}"
                    ;;
                SERVICE)
                    session_service="${value}"
                    ;;
                TTY)
                    session_tty="${value}"
                    ;;
            esac
        done < "${session_file}"

        if [ "${session_uid}" = "$(id -u)" ] && \
           [ "${session_type}" = 'wayland' ] && \
           [ "${session_service}" = 'gdm-password' ] && \
           [[ "${session_tty}" = tty* ]]; then
            printf '%s\n' "${session_tty}"
            return 0
        fi
    done

    return 1
}

find_sway_tty() {
    local session_file=''
    local session_tty=''
    local key=''
    local value=''

    if [[ "${XDG_VTNR:-}" =~ ^[0-9]+$ ]]; then
        printf 'tty%s\n' "${XDG_VTNR}"
        return 0
    fi

    if [ -n "${XDG_SESSION_ID:-}" ]; then
        session_file="${SESSIONS_DIR}/${XDG_SESSION_ID}"
        if [ -r "${session_file}" ]; then
            while IFS='=' read -r key value; do
                if [ "${key}" = 'TTY' ] && [[ "${value}" = tty* ]]; then
                    session_tty="${value}"
                    break
                fi
            done < "${session_file}"
        fi
    fi

    if [ -n "${session_tty}" ]; then
        printf '%s\n' "${session_tty}"
        return 0
    fi

    return 1
}

discover_gnome_display_env() {
    local gnome_pid=''
    local child_pid=''
    local entry=''
    local found_wayland=''
    local found_display=''

    gnome_pid="$(pgrep -u "$(id -u)" -x gnome-shell 2>/dev/null | head -n 1 || true)"
    if [ -n "${gnome_pid}" ]; then
        for child_pid in $(pgrep -P "${gnome_pid}" 2>/dev/null || true); do
            [ -r "/proc/${child_pid}/environ" ] || continue
            found_wayland=''
            found_display=''
            while IFS= read -r -d '' entry; do
                case "${entry}" in
                    WAYLAND_DISPLAY=wayland-*)
                        found_wayland="${entry#WAYLAND_DISPLAY=}"
                        ;;
                    DISPLAY=:[0-9]*)
                        found_display="${entry#DISPLAY=}"
                        ;;
                esac
            done < "/proc/${child_pid}/environ"

            if [ -n "${found_wayland}" ] && [ -n "${found_display}" ]; then
                GNOME_WAYLAND_DISPLAY="${found_wayland}"
                GNOME_DISPLAY="${found_display}"
                return 0
            fi
        done
    fi

    return 0
}

write_active_display_env() {
    local wayland_display="$1"
    local x_display="$2"
    local sway_sock="$3"
    local tmp_file="${ACTIVE_DISPLAY_ENV_FILE}.tmp.$$"

    {
        printf 'export WAYLAND_DISPLAY=%q\n' "${wayland_display}"
        if [ -n "${x_display}" ]; then
            printf 'export DISPLAY=%q\n' "${x_display}"
        fi
        if [ -n "${sway_sock}" ]; then
            printf 'export SWAYSOCK=%q\n' "${sway_sock}"
        else
            printf 'unset SWAYSOCK\n'
        fi
    } > "${tmp_file}" 2>/dev/null || {
        rm -f "${tmp_file}" 2>/dev/null || true
        return 1
    }

    chmod 600 "${tmp_file}" 2>/dev/null || true
    mv -f "${tmp_file}" "${ACTIVE_DISPLAY_ENV_FILE}" 2>/dev/null || {
        rm -f "${tmp_file}" 2>/dev/null || true
        return 1
    }
}

sync_systemd_and_dbus_display() {
    local wayland_display="$1"
    local x_display="$2"
    local sway_sock="$3"

    WAYLAND_DISPLAY="${wayland_display}" \
    DISPLAY="${x_display}" \
    SWAYSOCK="${sway_sock}" \
    dbus-update-activation-environment \
        WAYLAND_DISPLAY \
        DISPLAY \
        SWAYSOCK \
        >/dev/null 2>&1 || true

    if [ -n "${sway_sock}" ]; then
        systemctl --user set-environment \
            "WAYLAND_DISPLAY=${wayland_display}" \
            "DISPLAY=${x_display}" \
            "SWAYSOCK=${sway_sock}" \
            >/dev/null 2>&1 || true
    else
        systemctl --user unset-environment SWAYSOCK >/dev/null 2>&1 || true
        systemctl --user set-environment \
            "WAYLAND_DISPLAY=${wayland_display}" \
            "DISPLAY=${x_display}" \
            >/dev/null 2>&1 || true
    fi
}

sync_tmux_display() {
    local wayland_display="$1"
    local x_display="$2"
    local sway_sock="$3"
    local session_name=''

    command -v tmux >/dev/null 2>&1 || return 0
    tmux list-sessions >/dev/null 2>&1 || return 0

    tmux set-environment -g WAYLAND_DISPLAY "${wayland_display}" >/dev/null 2>&1 || true
    if [ -n "${x_display}" ]; then
        tmux set-environment -g DISPLAY "${x_display}" >/dev/null 2>&1 || true
    fi
    if [ -n "${sway_sock}" ]; then
        tmux set-environment -g SWAYSOCK "${sway_sock}" >/dev/null 2>&1 || true
    else
        tmux set-environment -gu SWAYSOCK >/dev/null 2>&1 || true
    fi

    while IFS= read -r session_name; do
        [ -n "${session_name}" ] || continue
        tmux set-environment -t "${session_name}" WAYLAND_DISPLAY "${wayland_display}" >/dev/null 2>&1 || true
        if [ -n "${x_display}" ]; then
            tmux set-environment -t "${session_name}" DISPLAY "${x_display}" >/dev/null 2>&1 || true
        fi
        if [ -n "${sway_sock}" ]; then
            tmux set-environment -t "${session_name}" SWAYSOCK "${sway_sock}" >/dev/null 2>&1 || true
        else
            tmux set-environment -t "${session_name}" -u SWAYSOCK >/dev/null 2>&1 || true
        fi
    done < <(tmux list-sessions -F '#S' 2>/dev/null || true)
}

apply_display_target() {
    local target="$1"

    case "${target}" in
        sway)
            write_active_display_env \
                "${SWAY_WAYLAND_DISPLAY}" \
                "${SWAY_DISPLAY}" \
                "${SWAY_SOCK}" || return 1
            sync_systemd_and_dbus_display \
                "${SWAY_WAYLAND_DISPLAY}" \
                "${SWAY_DISPLAY}" \
                "${SWAY_SOCK}"
            sync_tmux_display \
                "${SWAY_WAYLAND_DISPLAY}" \
                "${SWAY_DISPLAY}" \
                "${SWAY_SOCK}"
            ;;
        gnome)
            write_active_display_env \
                "${GNOME_WAYLAND_DISPLAY}" \
                "${GNOME_DISPLAY}" \
                '' || return 1
            sync_systemd_and_dbus_display \
                "${GNOME_WAYLAND_DISPLAY}" \
                "${GNOME_DISPLAY}" \
                ''
            sync_tmux_display \
                "${GNOME_WAYLAND_DISPLAY}" \
                "${GNOME_DISPLAY}" \
                ''
            ;;
        *)
            return 1
            ;;
    esac
}

monitor_kimpanel() {
    local session_pid="$1"
    local active_tty=''
    local requested_state=''
    local applied_state=''
    local requested_display=''
    local applied_display=''

    while kill -0 "${session_pid}" 2>/dev/null; do
        if IFS= read -r active_tty < "${ACTIVE_TTY_PATH}"; then
            if [ -n "${KIMPANEL_CONTROL_MODE}" ] && [ -n "${GNOME_TTY}" ]; then
                if [ "${active_tty}" = "${GNOME_TTY}" ]; then
                    requested_state='false'
                else
                    requested_state='true'
                fi

                if [ "${requested_state}" != "${applied_state}" ] && \
                   set_kimpanel_suspended "${requested_state}"; then
                    applied_state="${requested_state}"
                fi
            fi

            if [ -n "${SWAY_TTY}" ]; then
                requested_display=''
                if [ "${active_tty}" = "${SWAY_TTY}" ]; then
                    requested_display='sway'
                elif [ -n "${GNOME_TTY}" ] && [ "${active_tty}" = "${GNOME_TTY}" ]; then
                    requested_display='gnome'
                fi

                if [ -n "${requested_display}" ] && \
                   [ "${requested_display}" != "${applied_display}" ] && \
                   apply_display_target "${requested_display}"; then
                    applied_display="${requested_display}"
                fi
            fi
        fi
        sleep 0.2
    done
}

start_kimpanel_monitor() {
    if [ ! -r "${ACTIVE_TTY_PATH}" ]; then
        return 0
    fi

    GNOME_TTY="$(find_gnome_tty || true)"
    SWAY_TTY="$(find_sway_tty || true)"
    discover_gnome_display_env

    # Some Fcitx GNOME helpers exist only for XKB integration and do not
    # implement SetPanelSuspended; check the method before selecting this path.
    if [ -n "${GNOME_TTY}" ]; then
        if /usr/bin/gdbus introspect \
            --session \
            --dest org.fcitx.GnomeHelper \
            --object-path /org/fcitx/GnomeHelper \
            2>/dev/null | /usr/bin/grep -Fq 'SetPanelSuspended('; then
            KIMPANEL_CONTROL_MODE='helper'
        elif /usr/bin/gdbus introspect \
            --session \
            --dest org.kde.impanel \
            --object-path /org/kde/impanel \
            >/dev/null 2>&1; then
            # GNOME Shell caches extension modules until the next graphical login.
            KIMPANEL_CONTROL_MODE='extension'
        fi
    fi

    if [ -z "${KIMPANEL_CONTROL_MODE}" ] && [ -z "${SWAY_TTY}" ]; then
        return 0
    fi

    monitor_kimpanel "$$" &
    KIMPANEL_MONITOR_PID=$!
}

has_other_sway_fcitx_session() {
    local state_file=''
    local session_pid=''

    for state_file in "${STATE_DIR}"/*; do
        [ -f "${state_file}" ] || continue
        session_pid="${state_file##*/}"
        case "${session_pid}" in
            ''|*[!0-9]*)
                continue
                ;;
        esac

        if kill -0 "${session_pid}" 2>/dev/null; then
            return 0
        fi

        rm -f "${state_file}"
    done

    return 1
}

cleanup() {
    local status=$?

    trap - EXIT HUP INT TERM

    if [ -n "${SWAYMSG_PID}" ] && \
       kill -0 "${SWAYMSG_PID}" 2>/dev/null; then
        kill "${SWAYMSG_PID}" 2>/dev/null || true
        wait "${SWAYMSG_PID}" 2>/dev/null || true
    fi

    if [ -n "${KIMPANEL_MONITOR_PID}" ] && \
       kill -0 "${KIMPANEL_MONITOR_PID}" 2>/dev/null; then
        kill "${KIMPANEL_MONITOR_PID}" 2>/dev/null || true
        wait "${KIMPANEL_MONITOR_PID}" 2>/dev/null || true
    fi

    if [ -n "${FCITX_LAUNCHER_PID}" ] && \
       kill -0 "${FCITX_LAUNCHER_PID}" 2>/dev/null; then
        kill "${FCITX_LAUNCHER_PID}" 2>/dev/null || true
        wait "${FCITX_LAUNCHER_PID}" 2>/dev/null || true
    fi

    rm -f "${STATE_FILE}"
    if ! has_other_sway_fcitx_session; then
        if [ -n "${KIMPANEL_CONTROL_MODE}" ]; then
            set_kimpanel_suspended false || true
        fi
        if [ -n "${SWAY_TTY}" ]; then
            apply_display_target gnome || true
        fi
    fi
    rmdir "${STATE_DIR}" 2>/dev/null || true

    exit "${status}"
}

supervise_fcitx_launcher() {
    local session_pid="$1"
    local launcher_pid=''

    stop_supervised_launcher() {
        trap - EXIT HUP INT TERM
        if [ -n "${launcher_pid}" ] && kill -0 "${launcher_pid}" 2>/dev/null; then
            kill "${launcher_pid}" 2>/dev/null || true
            wait "${launcher_pid}" 2>/dev/null || true
        fi
        exit 0
    }

    trap stop_supervised_launcher EXIT HUP INT TERM

    while kill -0 "${session_pid}" 2>/dev/null; do
        WAYLAND_DISPLAY="${SWAY_WAYLAND_DISPLAY}" "${FCITX_LAUNCHER_BIN}" &
        launcher_pid=$!
        wait "${launcher_pid}" 2>/dev/null || true
        launcher_pid=''

        if ! kill -0 "${session_pid}" 2>/dev/null; then
            break
        fi

        sleep "${FCITX_LAUNCHER_RETRY_SECONDS}" &
        wait $! 2>/dev/null || true
    done
}

if [ -z "${WAYLAND_DISPLAY:-}" ] || [ -z "${SWAYSOCK:-}" ]; then
    printf '%s\n' 'sway-fcitx requires a running Sway session.' >&2
    exit 1
fi

mkdir -p -m 700 "${STATE_DIR}"
: > "${STATE_FILE}"
trap cleanup EXIT HUP INT TERM

start_kimpanel_monitor

supervise_fcitx_launcher "$$" &
FCITX_LAUNCHER_PID=$!

"${SWAYMSG_BIN}" \
    --monitor \
    --type subscribe \
    '["shutdown"]' \
    >/dev/null 2>&1 &
SWAYMSG_PID=$!
wait "${SWAYMSG_PID}" 2>/dev/null || true
